{
	"name": "gridly-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc --noEmit -p tsconfig.app.json && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"test": "bun test ./src/",
		"test:watch": "bun test --watch ./src/",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tests/tsconfig.json",
		"check": "bun run typecheck && bun fmt --check && bun run test && bun run build",
		"mock:api": "bun bruno/dev-api.ts",
		"mock:prepare": "bun bruno/mock-fixture.ts",
		"dev:mock": "vite --host 127.0.0.1 --mode mock",
		"test:ui": "bun tests/ui/smoke.ts",
		"test:coverage": "bun run test --coverage --coverage-reporter=lcov",
		"test:coverage:branches": "bun run test --preload ./tests/support/bunBranches.ts",
		"test:coverage:browser": "GRIDLY_BROWSER_COVERAGE=1 bun run test:ui",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@tabler/icons-react": "^3.0.0",
		"@tanstack/react-query": "^5.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.68.0",
		"motion": "^14.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "21.0.4",
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/bun": "^1.4.4",
		"@types/istanbul-lib-coverage": "^2.0.6",
		"@types/istanbul-lib-instrument": "^1.7.8",
		"@types/node": "^26.6.4",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-instrument": "^6.0.3",
		"postcss": "8.5.30",
		"typescript": "^5.9.0",
		"v8-to-istanbul": "^9.3.0",
		"vite": "^7.0.0"
	},
	"packageManager": "bun@1.4.4-canary.20261116.1"
}
