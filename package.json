{
	"name": "gridly-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"dev:demo": "vite --host 127.0.0.1 --mode demo",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"biome": "biome check --write src",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "bun run test && bun run lint && bun run build"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@tabler/icons-react": "^3.0.0",
		"@tanstack/react-query": "^5.0.0",
		"motion": "^14.1.0",
		"msw": "^2.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"playwright": "1.64.1",
		"typescript": "^5.9.0",
		"vite": "^7.0.0"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
