{
	"name": "gridly-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"test": "bun test ./tests/*.test.ts",
		"test:watch": "bun test --watch ./tests/*.test.ts",
		"lint": "biome check src tests *.json *.ts",
		"format": "biome format --write src tests *.json *.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
		"check": "bun run typecheck && bun run lint && bun run test && bun run build",
		"dev:mock": "vite --host 127.0.0.1 --mode mock",
		"test:ui": "bun tests/ui/smoke.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@tabler/icons-react": "^3.0.0",
		"@tanstack/react-query": "^5.0.0",
		"@usespaceui/squircle": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.68.0",
		"motion": "^14.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.4",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^5.9.0",
		"vite": "^7.0.0"
	},
	"packageManager": "bun@1.4.3"
}
